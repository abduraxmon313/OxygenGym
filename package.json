{
  "name": "oxygengym",
  "version": "1.2.0",
  "description": "OxygenGym — zal bari uchun savdo va ombor dasturi",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "build": "npm run build:react && electron-builder --win",
    "build:react": "cd renderer && npm run build",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": "OxygenGym",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/abduraxmon313/OxygenGym.git"
  },
  "build": {
    "appId": "com.oxygengym.pos",
    "productName": "OxygenGym",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/build/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OxygenGym",
      "artifactName": "OxygenGym-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "abduraxmon313",
        "repo": "OxygenGym"
      }
    ]
  },
  "dependencies": {
    "better-sqlite3": "^11.6.0",
    "electron-log": "^5.2.4",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
